# backend/.env.example — copy to backend/.env and fill in.
# Loaded by pydantic-settings (src/allaroundfood/config.py) plus a few direct
# os.environ reads (video_import.py, __main__.py). All values are optional and
# have working defaults except where noted.
#
# NOTE: as of the Phase 4 import-queue worker (ADR 0007 §3), the Anthropic
# parsing key (ANTHROPIC_API_KEY_PARSING) and the Supabase service-role keys
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY) live in the WORKER env — this
# backend/.env — NOT in Vercel/the frontend. Claude parsing now runs in the
# containerized worker (`python -m allaroundfood.worker`), not the Next.js API.

# ── Kroger official Products API (enables the only *official* pricing adapter) ──
# OAuth2 client credentials from https://developer.kroger.com
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# ── Pricing adapters ──
# Kill-switch: set true to disable all unofficial scraping adapters
# (Walmart / Costco / Whole Foods / Instacart). Leave false for personal use.
DISABLE_UNOFFICIAL_INGESTION=false

# ── Canonical product matching ──
# Local sentence-transformers model (downloaded on first use), 384-dim.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ── Storage ──
# Directory holding pricing/OCR Parquet files. Defaults to <repo>/data.
# PRICING_DATA_DIR=

# ── OCR receipt pipeline ──
# Path to the Qwen2-VL GGUF weights (not committed; see ocr/README.md).
QWEN_GGUF_PATH=

# ── Video recipe import (yt-dlp + ffmpeg + whisper.cpp) ──
# External binaries — must be installed on the host (NOT pip packages).
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
# whisper.cpp model name + optional models dir (pywhispercpp).
WHISPER_MODEL=base.en
# WHISPER_MODELS_DIR=
# Hard timeout (seconds) for a single video import.
VIDEO_IMPORT_TIMEOUT_S=180

# ── Import-queue worker: Supabase (service-role — bypasses RLS) ──
# The worker reads/writes with the service-role key and stamps user_id itself,
# since service-role calls have no auth.uid(). Keep this key out of the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Import-queue worker: Anthropic (Claude recipe/receipt parsing) ──
# Moved off Vercel/frontend into the worker (ADR 0007 §3).
ANTHROPIC_API_KEY_PARSING=

# Run the LLM-as-judge eval pipeline after a recipe parse (fire-and-forget).
# Set false to defer evals (Phase 5).
RUN_EVALS=true

# Poison-job retry cap — a job stops being reclaimed once attempts reaches this.
WORKER_MAX_ATTEMPTS=3

# ── Server (uvicorn via `python -m allaroundfood`) ──
HOST=0.0.0.0
PORT=8000
