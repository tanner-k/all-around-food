# backend/.env.example — copy to backend/.env and fill in.
# Loaded by pydantic-settings (src/allaroundfood/config.py) plus a few direct
# os.environ reads (video_import.py, __main__.py). The personal worker requires
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and IMPORT_OWNER_USER_ID; parsing
# also requires ANTHROPIC_API_KEY_PARSING.
#
# Anthropic and Supabase service-role credentials live only on the personal Mac
# worker, not in Vercel or the frontend. Recipe import runs through
# `python -m allaroundfood.worker --watch`.

# ── Kroger official Products API (enables the only *official* pricing adapter) ──
# OAuth2 client credentials from https://developer.kroger.com
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# ── Pricing adapters ──
# Kill-switch: set true to disable all unofficial scraping adapters
# (Walmart / Costco / Whole Foods / Instacart). Leave false for personal use.
DISABLE_UNOFFICIAL_INGESTION=false

# ── Canonical product matching ──
# Local sentence-transformers model (downloaded on first use), 384-dim.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ── Storage ──
# Directory holding pricing/OCR Parquet files. Defaults to <repo>/data.
# PRICING_DATA_DIR=

# ── OCR receipt pipeline ──
# Path to the Qwen2-VL GGUF weights (not committed; see ocr/README.md).
QWEN_GGUF_PATH=

# ── Video recipe import (yt-dlp + ffmpeg + whisper.cpp) ──
# External binaries — must be installed on the host (NOT pip packages).
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
# whisper.cpp model name + optional models dir (pywhispercpp).
WHISPER_MODEL=base.en
# WHISPER_MODELS_DIR=
# Timeout (seconds) for each video-import subprocess.
VIDEO_IMPORT_TIMEOUT_S=180

# ── Import-queue worker: Supabase (service-role — bypasses RLS) ──
# The worker claims owner jobs and publishes token-fenced JSON drafts via RPCs.
# Keep the service-role key out of the frontend. Use the existing auth user's UUID.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IMPORT_OWNER_USER_ID=

# ── Import-queue worker: Anthropic recipe parsing ──
ANTHROPIC_API_KEY_PARSING=

# Keep source-containing development evaluations off for normal personal imports.
RUN_EVALS=false

# Legacy setting; Task 6 SQL fixes the poison-job cap at three attempts.
WORKER_MAX_ATTEMPTS=3

# ── Server (uvicorn via `python -m allaroundfood`) ──
HOST=0.0.0.0
PORT=8000
