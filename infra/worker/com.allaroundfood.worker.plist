<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference shape only. Do not load this file: its paths are placeholders.
  Generate a loadable plist with install-macos-worker.sh so plistlib resolves
  the actual checkout, virtualenv, binaries, and private log directory.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.allaroundfood.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BACKEND_VENV_PYTHON__</string>
    <string>-m</string>
    <string>allaroundfood.worker</string>
    <string>--watch</string>
    <string>--interval</string>
    <string>30</string>
    <string>--limit</string>
    <string>1</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__BACKEND_CHECKOUT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__PRIVATE_LOG_DIR__/worker.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PRIVATE_LOG_DIR__/worker.err.log</string>
</dict>
</plist>
