# ============================================================
# all-around-food — environment variable reference
# Copy this file to .env.local (never commit .env.local)
# All variables are server-side only — never use NEXT_PUBLIC_*
# for secrets. See frontend/src/lib/env.ts for validation.
# ============================================================

# ----------------------------------------------------------
# Database (Vercel Postgres / Neon)
# Provision via: Vercel dashboard → Storage → Create database
# ----------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ----------------------------------------------------------
# Anthropic — used by the recipe import endpoint (server only)
# https://console.anthropic.com/settings/keys
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------
# Auth.js v5 (next-auth@beta)
# Generate a secret with: openssl rand -base64 32
# ----------------------------------------------------------
AUTH_SECRET=replace-with-openssl-rand-base64-32-output

# Deployment URL — required in production
# AUTH_URL takes precedence; NEXTAUTH_URL is the legacy alias
AUTH_URL=https://your-app.vercel.app
# NEXTAUTH_URL=https://your-app.vercel.app

# ----------------------------------------------------------
# Allowlist — comma-separated email addresses permitted to sign in
# ----------------------------------------------------------
ALLOWED_EMAILS=you@example.com,friend@example.com

# ----------------------------------------------------------
# OAuth provider credentials (choose one or more)
# Google: https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# ----------------------------------------------------------
# Node environment (set automatically by Next.js / Vercel)
# Values: development | test | production
# ----------------------------------------------------------
NODE_ENV=development
